# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:8080/callback or https://<your-vercel-domain>.vercel.app/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upstash Redis / Vercel KV Credentials (for persisting OAuth tokens)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Vercel KV default variable names:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional
# GOOGLE_SCOPE=https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly
# PORT=8080
